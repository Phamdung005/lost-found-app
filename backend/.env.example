DATABASE_URL=postgresql://postgres:password@localhost:5432/findbox
JWT_SECRET=replace_with_a_long_random_secret
PORT=3000

# Gemini REST API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MATCH_THRESHOLD=0.78

# MinIO / S3-compatible object storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=findboxadmin
MINIO_SECRET_KEY=replace_with_a_long_random_secret
MINIO_BUCKET=findbox-images
MINIO_FORCE_PATH_STYLE=true
MINIO_PRESIGNED_URL_TTL_SECONDS=900
