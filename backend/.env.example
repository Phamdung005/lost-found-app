DATABASE_URL=postgresql://postgres:password@localhost:5432/findbox
JWT_SECRET=replace_with_a_long_random_secret
PORT=3000

# Gemini REST API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MATCH_THRESHOLD=0.78

# Supabase Storage (private bucket)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=findbox-images
SUPABASE_SIGNED_URL_TTL_SECONDS=900
