DATABASE_URL=postgresql://postgres:password@localhost:5432/findbox
JWT_SECRET=replace_with_a_long_random_secret
PORT=3000

# Gemini REST API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MATCH_THRESHOLD=0.78

# Neon Object Storage (private bucket)
AWS_ENDPOINT_URL_S3=https://your-branch-id.storage.c-2.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=replace_with_neon_storage_access_key
AWS_SECRET_ACCESS_KEY=replace_with_neon_storage_secret_key
AWS_REGION=us-east-2
NEON_STORAGE_BUCKET=findbox-images
NEON_SIGNED_URL_TTL_SECONDS=900
